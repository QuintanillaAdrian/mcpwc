# Bearer token que debe enviar tu backend en cada request
# Authorization: Bearer <API_TOKEN>
API_TOKEN=change-this-to-a-secure-random-token

# Puerto del servidor Express (opcional, default: 3001)
API_PORT=3001

# URL base del backend que expone GET /api/internal/tenants/active
# Si no se define, el servidor arranca sin tenants precargados
BACKEND_INTERNAL_URL=https://tu-backend.com

# Token para autenticar la llamada interna al backend
BACKEND_INTERNAL_TOKEN=change-this-to-internal-token

# Clave AES-256-GCM para descifrar credenciales (hex de 64 chars = 32 bytes)
# Debe coincidir exactamente con la clave que usa el backend para cifrar
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-this-to-a-64-char-hex-key
